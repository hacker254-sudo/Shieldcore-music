<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShieldCore</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background: #121212; color: white; font-family: system-ui; padding-bottom: 140px; }
       .card { background: #181818; border-radius: 8px; transition:.2s; }
       .card:hover { background: #282828; }
       .btn { background: #1DB954; padding: 10px 24px; border-radius: 500px; font-weight: 700; }
       .btn:hover { background: #1ed760; }
       .input { background: #242424; border: none; padding: 12px; border-radius: 4px; width: 100%; color: white; }
       .player { position: fixed; bottom: 60px; left: 0; right: 0; background: #181818; border-top: 1px solid #282828; z-index: 50; }
       .nav { position: fixed; bottom: 0; left: 0; right: 0; background: #000; z-index: 50; }
       .progress { height: 2px; background: #535353; cursor: pointer; }
       .progress-bar { height: 100%; background: white; width: 0%; }
       .scroll-x { display: flex; overflow-x: auto; gap: 16px; padding-bottom: 8px; }
       .scroll-x::-webkit-scrollbar { display: none; }
       .artist-card { min-width: 140px; text-align: center; }
       .track-card { min-width: 160px; }
        #ytplayer { position: absolute; left: -9999px; }
    </style>
</head>
<body>
    <!-- Écran Connexion -->
    <div id="authScreen" class="min-h-screen flex items-center justify-center p-4">
        <div class="card p-8 w-full max-w-md">
            <h1 class="text-5xl font-bold text-center mb-2">ShieldCore</h1>
            <p class="text-gray-400 text-center mb-8">Toute la musique, gratuitement</p>
            
            <div id="loginForm">
                <input id="loginEmail" type="email" placeholder="Email" class="input mb-3">
                <input id="loginPassword" type="password" placeholder="Mot de passe" class="input mb-4">
                <button onclick="login()" class="btn w-full mb-4">Se connecter</button>
                <p class="text-center text-sm text-gray-400">Pas de compte? 
                    <span onclick="showSignup()" class="text-white cursor-pointer font-semibold">S'inscrire</span>
                </p>
            </div>

            <div id="signupForm" class="hidden">
                <input id="signupName" type="text" placeholder="Nom d'utilisateur" class="input mb-3">
                <input id="signupEmail" type="email" placeholder="Email" class="input mb-3">
                <input id="signupPassword" type="password" placeholder="Mot de passe" class="input mb-4">
                <button onclick="signup()" class="btn w-full mb-4">S'inscrire</button>
                <p class="text-center text-sm text-gray-400">Déjà un compte? 
                    <span onclick="showLogin()" class="text-white cursor-pointer font-semibold">Se connecter</span>
                </p>
            </div>
            <p id="authError" class="text-red-500 text-sm mt-3 text-center"></p>
        </div>
    </div>

    <!-- App Principale -->
    <div id="appScreen" class="hidden">
        <!-- Header -->
        <header class="p-4 flex justify-between items-center">
            <h1 class="text-2xl font-bold">Bonjour</h1>
            <div class="flex items-center gap-4">
                <i onclick="showSearch()" class="fas fa-search text-xl cursor-pointer"></i>
                <i onclick="logout()" class="fas fa-gear text-xl cursor-pointer text-gray-400"></i>
            </div>
        </header>

        <main class="px-4">
            <!-- Recherche -->
            <div id="searchBar" class="mb-6 hidden">
                <div class="relative">
                    <i class="fas fa-search absolute left-4 top-4 text-gray-400"></i>
                    <input id="searchInput" type="text" placeholder="Que veux-tu écouter?" 
                           class="input pl-12 py-3" onkeypress="if(event.key==='Enter') searchMusic()">
                </div>
            </div>

            <!-- Titres tendance -->
            <div class="mb-8">
                <h2 id="sectionTitle1" class="text-2xl font-bold mb-4">Titres tendance</h2>
                <div id="tracksList" class="scroll-x"></div>
            </div>

            <!-- Artistes populaires -->
            <div class="mb-8">
                <h2 id="sectionTitle2" class="text-2xl font-bold mb-4">Artistes populaires</h2>
                <div id="artistsList" class="scroll-x"></div>
            </div>
        </main>

        <!-- Player -->
        <div id="player" class="player hidden">
            <div class="progress" onclick="seek(event)">
                <div id="progressBar" class="progress-bar"></div>
            </div>
            <div class="p-2 px-4 flex items-center justify-between">
                <div class="flex items-center gap-3 w-2/3" onclick="openFullPlayer()">
                    <img id="playerImg" src="" class="w-12 h-12 rounded">
                    <div class="truncate">
                        <p id="playerTitle" class="font-semibold text-sm truncate">-</p>
                        <p id="playerArtist" class="text-xs text-gray-400 truncate">-</p>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <i id="playBtn" onclick="togglePlay()" class="fas fa-play text-xl cursor-pointer"></i>
                </div>
            </div>
        </div>

        <!-- Nav en bas -->
        <div class="nav flex justify-around py-3">
            <div onclick="showHome()" class="text-center cursor-pointer">
                <i class="fas fa-home text-2xl"></i>
                <p class="text-xs mt-1">Accueil</p>
            </div>
            <div onclick="showSearch()" class="text-center cursor-pointer text-gray-500">
                <i class="fas fa-search text-2xl"></i>
                <p class="text-xs mt-1">Rechercher</p>
            </div>
            <div class="text-center cursor-pointer text-gray-500">
                <i class="fas fa-book text-2xl"></i>
                <p class="text-xs mt-1">Bibliothèque</p>
            </div>
        </div>
    </div>

    <div id="ytplayer"></div>

<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
    import { getAuth, createUserWithEmailAndPassword, signInWithEmailAndPassword, onAuthStateChanged, signOut, updateProfile } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";
    import { getFirestore, doc, setDoc } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

    const firebaseConfig = {
        apiKey: "AIzaSyCYnERIIFVzLN7LxGm26ZvcOlb1n8zXQbk",
        authDomain: "shieldcore-7294e.firebaseapp.com",
        projectId: "shieldcore-7294e",
        storageBucket: "shieldcore-7294e.firebasestorage.app",
        messagingSenderId: "981883804803",
        appId: "1:981883804803:web:d0945de32d23aea6bb6b90"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);

    const YT_API_KEY = "AIzaSyCQsxZeVcdPwuB8KCsLxQhYeB8QqEqy5-8";
    let ytPlayer, currentPlaylist = [], currentIndex = 0, isPlaying = false;

    const tag = document.createElement('script');
    tag.src = "https://www.youtube.com/iframe_api";
    document.head.appendChild(tag);

    window.onYouTubeIframeAPIReady = () => {
        ytPlayer = new YT.Player('ytplayer', { height: '0', width: '0', events: { 'onStateChange': onPlayerStateChange, 'onReady': () => setInterval(updateProgress, 500) } });
    };

    function onPlayerStateChange(e) {
        if (e.data == YT.PlayerState.ENDED) nextTrack();
        if (e.data == YT.PlayerState.PLAYING) {
            isPlaying = true;
            document.getElementById('playBtn').className = 'fas fa-pause text-xl cursor-pointer';
        }
        if (e.data == YT.PlayerState.PAUSED) {
            isPlaying = false;
            document.getElementById('playBtn').className = 'fas fa-play text-xl cursor-pointer';
        }
    }

    window.showSignup = () => { document.getElementById('loginForm').classList.add('hidden'); document.getElementById('signupForm').classList.remove('hidden'); }
    window.showLogin = () => { document.getElementById('signupForm').classList.add('hidden'); document.getElementById('loginForm').classList.remove('hidden'); }

    window.signup = async () => {
        const name = document.getElementById('signupName').value;
        const email = document.getElementById('signupEmail').value;
        const password = document.getElementById('signupPassword').value;
        try {
            const userCred = await createUserWithEmailAndPassword(auth, email, password);
            await updateProfile(userCred.user, { displayName: name });
            await setDoc(doc(db, "users", userCred.user.uid), { name, email, createdAt: new Date() });
        } catch (e) { document.getElementById('authError').textContent = e.message; }
    }

    window.login = async () => {
        try { await signInWithEmailAndPassword(auth, document.getElementById('loginEmail').value, document.getElementById('loginPassword').value); } 
        catch (e) { document.getElementById('authError').textContent = 'Email ou mot de passe incorrect'; }
    }

    window.logout = () => signOut(auth);

    onAuthStateChanged(auth, (user) => {
        if (user) {
            document.getElementById('authScreen').classList.add('hidden');
            document.getElementById('appScreen').classList.remove('hidden');
            loadHome();
        } else {
            document.getElementById('authScreen').classList.remove('hidden');
            document.getElementById('appScreen').classList.add('hidden');
            if (ytPlayer) ytPlayer.stopVideo();
        }
    });

    window.showHome = () => {
        document.getElementById('searchBar').classList.add('hidden');
        loadHome();
    }

    window.showSearch = () => {
        document.getElementById('searchBar').classList.remove('hidden');
        document.getElementById('searchInput').focus();
    }

    async function loadHome() {
        document.getElementById('sectionTitle1').textContent = "Titres tendance";
        document.getElementById('sectionTitle2').textContent = "Artistes populaires";
        searchYT("top hits 2024 rap fr", 'tracksList');
        searchArtists();
    }

    window.searchMusic = () => {
        const query = document.getElementById('searchInput').value;
        if (query) {
            document.getElementById('sectionTitle1').textContent = `Résultats`;
            document.getElementById('sectionTitle2').textContent = "Artistes";
            searchYT(query, 'tracksList');
            searchArtists(query);
        }
    }

    async function searchYT(query, containerId) {
        const res = await fetch(`https://www.googleapis.com/youtube/v3/search?part=snippet&q=${encodeURIComponent(query)}&type=video&videoCategoryId=10&maxResults=15&key=${YT_API_KEY}`);
        const data = await res.json();
        currentPlaylist = data.items.map(item => ({
            id: item.id.videoId,
            title: item.snippet.title.replace(/&quot;/g, '"').replace(/&#39;/g, "'"),
            artist: item.snippet.channelTitle,
            img: item.snippet.thumbnails.high.url
        }));
        document.getElementById(containerId).innerHTML = currentPlaylist.map((t, i) => `
            <div class="track-card cursor-pointer" onclick="playTrack(${i})">
                <img src="${t.img}" class="w-full aspect-square rounded mb-2 object-cover">
                <p class="font-semibold text-sm truncate">${t.title}</p>
                <p class="text-xs text-gray-400 truncate">${t.artist}</p>
            </div>
        `).join('');
    }

    async function searchArtists(query = "rappeurs français populaires") {
        const res = await fetch(`https://www.googleapis.com/youtube/v3/search?part=snippet&q=${encodeURIComponent(query)}&type=channel&maxResults=10&key=${YT_API_KEY}`);
        const data = await res.json();
        const artists = data.items;
        document.getElementById('artistsList').innerHTML = artists.map(a => `
            <div class="artist-card cursor-pointer" onclick="searchYT('${a.snippet.title} songs', 'tracksList')">
                <img src="${a.snippet.thumbnails.high.url}" class="w-full aspect-square rounded-full mb-2 object-cover">
                <p class="font-semibold text-sm truncate">${a.snippet.title}</p>
            </div>
        `).join('');
    }

    window.playTrack = (index) => {
        currentIndex = index;
        const track = currentPlaylist[index];
        ytPlayer.loadVideoById(track.id);
        document.getElementById('player').classList.remove('hidden');
        document.getElementById('playerImg').src = track.img;
        document.getElementById('playerTitle').textContent = track.title;
        document.getElementById('playerArtist').textContent = track.artist;
    }

    window.togglePlay = () => { if (ytPlayer) isPlaying? ytPlayer.pauseVideo() : ytPlayer.playVideo(); }
    window.nextTrack = () => { if (currentIndex < currentPlaylist.length - 1) playTrack(currentIndex + 1); }
    window.seek = (e) => { ytPlayer.seekTo(ytPlayer.getDuration() * (e.offsetX / e.target.offsetWidth)); }

    function updateProgress() {
        if (!ytPlayer?.getDuration) return;
        document.getElementById('progressBar').style.width = (ytPlayer.getCurrentTime() / ytPlayer.getDuration()) * 100 + '%';
    }
    window.openFullPlayer = () => {}; // Pour plus tard
</script>
</body>
</html>